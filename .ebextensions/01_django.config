# Elastic Beanstalk (Python on Amazon Linux 2023).
# Runs once per deployment on the leader instance, after the app is unpacked.
option_settings:
  aws:elasticbeanstalk:application:environment:
    DJANGO_SETTINGS_MODULE: config.settings

container_commands:
  00_check_aws:
    command: "source /var/app/venv/*/bin/activate && python manage.py check_aws"
    leader_only: true
  01_migrate:
    command: "source /var/app/venv/*/bin/activate && python manage.py migrate --noinput"
    leader_only: true
  02_collectstatic:
    command: "source /var/app/venv/*/bin/activate && python manage.py collectstatic --noinput"
  03_bootstrap:
    command: "source /var/app/venv/*/bin/activate && python manage.py bootstrap"
    leader_only: true
